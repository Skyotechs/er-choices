{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "pnpm": "10.26.1",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "pnpm": "10.26.1",
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "pnpm": "10.26.1",
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
