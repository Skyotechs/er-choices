{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "pnpm": "10.26.1",
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true
    },
    "preview": {
      "pnpm": "10.26.1",
      "distribution": "internal",
      "autoIncrement": true,
      "environment": "preview",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "er-choices-production.up.railway.app"
      }
    },
    "production": {
      "pnpm": "10.26.1",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DOMAIN": "er-choices-production.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "language": "en-US",
        "appName": "ER Choices",
        "ascAppId": "6761451449"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
